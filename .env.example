# Every environment variable the app reads. Copy what you need into
# apps/web/.env.local (never committed). In production these are Container
# Apps secrets and env vars (docs/runbooks/provision-production.md).

# Database. Unset = your local dev server (postgresql://postgres:postgres@127.0.0.1:5433/postgres),
# started by `pnpm dev`. Set it and the same code talks to Azure instead.
# DATABASE_URL=postgresql://user:password@host.postgres.database.azure.com:5432/postgres?sslmode=require

# Connection pool size. Keep it at 1 against a shared or B1ms server.
# PG_POOL_MAX=1

# Tests only: run the DB in-process via PGlite instead of connecting to a server.
# PGLITE_DATA_DIR=memory://

# GitHub sign-in (Auth.js). Create a GitHub OAuth app with callback URL
# http://localhost:3000/api/auth/callback/github (production uses its own
# OAuth app with the live URL).
# AUTH_SECRET=            # openssl rand -base64 33
# GITHUB_ID=
# GITHUB_SECRET=

# Trust the X-Forwarded-Host that a proxy (Azure's ingress, or local dev)
# sends, so Auth.js builds callback URLs for the public address.
# AUTH_TRUST_HOST=true

# Upstash Redis (live locations, incident geo index). No local stand-in;
# see docs/adr/0012-upstash-redis-cloud-dependency.md.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Blob + queue storage. Unset = Azurite, the local emulator started by `pnpm dev`.
# AZURE_STORAGE_CONNECTION_STRING=

# Log verbosity: debug | info | warn | error
# LOG_LEVEL=info
